{
  "name": "cuppy-land",
  "version": "1.0.0",
  "description": "Olivia's World tablet game",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate:sfx": "node scripts/validate-sfx-static.js",
    "validate:sfx:changed": "node scripts/validate-sfx-changed.js",
    "validate:sfx:matrix": "node --test tests/sfx-validation.test.js tests/sfx-dispatch-determinism.test.js tests/audio-sfx-guards.test.js tests/sfx-event-capture.test.js tests/sfx-browser-matrix.test.js tests/sfx-edge-cases.test.js",
    "validate:sfx:full": "npm run validate:sfx && npm test",
    "prepare:web": "powershell -ExecutionPolicy Bypass -File .\\scripts\\prepare-web.ps1",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-release.ps1",
    "cap:copy": "npm run prepare:web && npx cap copy android",
    "cap:sync": "npm run prepare:web && npx cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korygrandy/cuppyland.git"
  },
  "keywords": [],
  "author": "Kory Grandy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/korygrandy/cuppyland/issues"
  },
  "homepage": "https://github.com/korygrandy/cuppyland#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
